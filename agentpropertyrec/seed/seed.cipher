
// Agents
CREATE
    (a1:Agent {
        name: 'Alice',
        sex: 'Female',
        phone_number: '081234567001'
    }),
    (a2:Agent {
        name: 'Bob',
        sex: 'Male',
        phone_number: '081234567002'
    }),
    (a3:Agent {
        name: 'Charlie',
        sex: 'Male',
        phone_number: '081234567003'
    })

// Properties
CREATE
    (p1:Property {
        title: 'Modern House in Palembang'
    }),
    (p2:Property {
        title: 'Luxury Apartment in Jakarta'
    }),
    (p3:Property {
        title: 'Family House in Bandung'
    })

// Property Owners
CREATE
    (o1:PropertyOwner {
        name: 'David'
    }),
    (o2:PropertyOwner {
        name: 'Eva'
    })
	
//Relationships 

CREATE
    (a1)-[:SALES]->(p1),
    (a2)-[:SALES]->(p2),
    (a3)-[:SALES]->(p3),

    (p1)-[:CO_LIST_WITH]->(a2),
    (p2)-[:CO_LIST_WITH]->(a3),
	(p1)-[:CO_LIST_WITH]->(a2),
    (p1)-[:CO_LIST_WITH]->(a3),
    (p2)-[:CO_LIST_WITH]->(a1),
    (p3)-[:CO_LIST_WITH]->(a1);

    (o1)-[:OWN]->(p1),
    (o2)-[:OWN]->(p2),
    (o2)-[:OWN]->(p3)	